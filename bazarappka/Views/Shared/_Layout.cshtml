<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BazarApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/bazarappka.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3 position-relative">
            <div class="container-fluid">
                <!-- Right: Nav links -->
                <ul class="navbar-nav d-flex align-items-center ms-auto">
                    <li class="nav-item me-4">
                        <a class="nav-link nav-highlight" asp-area="" asp-controller="AutaInfoes" asp-action="Index">List of Vehicles</a>
                    </li>
                    <li class="nav-item me-4">
                        <a class="nav-link nav-highlight" asp-area="" asp-controller="Home" asp-action="Statistics">Statistics</a>
                    </li>
                </ul>

                <!-- Center: Brand -->
                <a class="navbar-brand main-brand position-absolute top-50 start-50 translate-middle" asp-area="" asp-controller="Home" asp-action="Index">BazarApp</a>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <style>
        .navbar .main-brand {
            font-weight: bold;
            font-size: 1.5rem;
            color: #0d6efd; 
            text-shadow: 1px 1px 2px rgba(0,0,0,0.1);
        }

        .navbar .nav-link.nav-highlight {
            margin-right: 1rem;      
            font-weight: 500;
            color: #343a40;          
            transition: color 0.2s;
        }

        .navbar .nav-link.nav-highlight:hover {
            color: #0d6efd;          
}</style>

    <footer class="border-top footer text-muted">
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

