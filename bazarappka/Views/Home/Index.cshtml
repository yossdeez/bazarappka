@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center my-5">
    <h1 class="display-4 fw-bold">Welcome to BazarApp</h1>
    <p class="lead">
        Here you can add new vehicles, edit details, or check statistics about these vehicles.
    </p>
</div>

<div class="container mt-4">
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title fw-bold">Vehicle List</h5>
                        <p class="card-text">
                            Browse our cars, add new entries, update existing vehicles, or remove them in the Edit page.
                        </p>
                    </div>
                    <a asp-controller="AutaInfoes" asp-action="Index" class="btn btn-primary mt-3">View Vehicle List</a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title fw-bold">Statistics</h5>
                        <p class="card-text">
                            Explore statistics about total vehicles, mileage ranges, fuel types, and vehicle conditions.
                        </p>
                    </div>
                    <a asp-controller="Home" asp-action="Statistics" class="btn btn-success mt-3">View Statistics</a>
                </div>
            </div>
        </div>
    </div>
</div>
